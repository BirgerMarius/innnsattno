[Unit]
Description=Publiser avgrenset APT-status for Innsatt.no
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/innsatt-server-maintenance-collect
TimeoutStartSec=6min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/innsatt-server-maintenance /run/lock /var/lib/apt/lists /var/cache/apt /var/log/apt
